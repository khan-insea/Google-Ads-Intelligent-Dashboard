# ==========================================
# GOOGLE ADS INTELLIGENT DASHBOARD CONFIG
# ==========================================

# 1. Google Ads API Credentials
# Lấy Developer Token tại: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN="YOUR_DEVELOPER_TOKEN"

# 2. Google OAuth Client Configuration
# Tạo Client ID & Client Secret tại https://console.cloud.google.com/apis/credentials
# Thêm Redirect URI là: http://localhost:3000/api/auth/google/callback
GOOGLE_ADS_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_ADS_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Customer ID thật của tài khoản quảng cáo (dạng 123-456-7890)
# Login Customer ID là ID của tài khoản MCC quản lý (nếu có)
GOOGLE_ADS_CUSTOMER_ID="YOUR_CUSTOMER_ID"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# 3. Database Selection (Supabase hoặc Postgres)
# Sử dụng Supabase Client hoặc lưu trữ local tự động thông qua data/db_store.json
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 4. Email Reporting (Resend API)
# Lấy API key tại https://resend.com
RESEND_API_KEY="re_your_api_key"
REPORT_FROM_EMAIL="googleads@a96agency.com"
REPORT_TO_EMAIL="ads.a96agency@gmail.com"

# 5. Security & Administration
# Email & Password của Admin dùng để login vào hệ thống dashboard
ADMIN_EMAIL="ads.a96agency@gmail.com"
ADMIN_PASSWORD="super_secret_password_123"

# Secret dùng để bảo vệ API cron job dọn dẹp và cập nhật dữ liệu hàng ngày
CRON_SECRET="your_cron_secret_phrase_2026"

# URL của website - AI Studio tự động truyền khi chạy môi trường Cloud Run
APP_URL="http://localhost:3000"
